# ============================================================
# Copiar a .env y rellenar con valores reales.
# NUNCA commitear .env — solo .env.example va al repo.
# ============================================================

# Entorno
APP_ENV=development
DEBUG=false

# HTTP Basic Auth (usuario único: Leo)
APP_USERNAME=leo
APP_PASSWORD=changeme

# Clave para firmar sesiones — generar con: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Base de datos PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arbitraje_libros

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Mercado Libre (opcional hasta Sprint 9)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# Google Books (opcional — fallback a Open Library si está vacío)
GOOGLE_BOOKS_API_KEY=

# Reglas de negocio
MIN_MARGIN_CENTS=5000
MIN_MARGIN_PCT=20.0

# Frecuencia del scheduler (en horas)
SCAN_INTERVAL_HOURS=4

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
